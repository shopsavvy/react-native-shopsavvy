{
  "name": "react-native-shopsavvy",
  "version": "1.0.0",
  "description": "React Native hooks and components for ShopSavvy Data API — product search, price comparison, price history, and deals",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "shopsavvy",
    "price-comparison",
    "shopping",
    "hooks",
    "product-search",
    "deals",
    "e-commerce"
  ],
  "author": "ShopSavvy by Monolith Technologies, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shopsavvy/react-native-shopsavvy"
  },
  "homepage": "https://shopsavvy.com/data",
  "bugs": {
    "url": "https://github.com/shopsavvy/react-native-shopsavvy/issues"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.70.0"
  },
  "dependencies": {
    "@shopsavvy/sdk": "^1.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
